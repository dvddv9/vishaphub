{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vishap",
  "version": "7.3.17",
  "identifier": "com.vishap.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ui-next run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "if exist ui-next\\package.json (npm --prefix ui-next run build:desktop) else (npm --prefix ..\\ui-next run build:desktop)",
    "frontendDist": "../ui-next/out"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

