# Vishap — Next.js dashboard environment.
# Copy to `.env.local` and fill in the real values.

# --- FastAPI backend -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5001

# Sent as the `X-API-Key` header. Leave empty when the backend runs without
# VISHAP_API_KEY (local dev binds to 127.0.0.1 in that case).
NEXT_PUBLIC_API_KEY=

# --- Clerk (https://dashboard.clerk.com -> API keys) ------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Clerk routing (optional) ----------------------------------------------
# Unauthenticated users are bounced to "/" (the dashboard shows a sign-in prompt).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/analyze

# --- Desktop shell (Tauri) --------------------------------------------------
# Leave unset for the hosted web app. Set to 1 only by the desktop build
# (`npm run build:desktop`, which exports a static site and stubs out Clerk).
# NEXT_PUBLIC_DESKTOP=1
