# vishap-generator - environment variables
# Copy to .env or set them in the PowerShell session. Never commit real keys.
# The generator does not read .env itself: set the variables in the shell
# (PowerShell: $env:NAME = "value"), so a stale file cannot override the session.

# === Model (any OpenAI-compatible endpoint) ===
VISHAP_LLM_PROVIDER=custom
CUSTOM_LLM_URL=https://api.deepseek.com
CUSTOM_LLM_MODEL=deepseek-flash
CUSTOM_LLM_KEY=
# DeepSeek: without this the reasoning eats the token limit
CUSTOM_LLM_THINKING=disabled
# CUSTOM_LLM_REASONING_EFFORT=low
# Local model (Ollama): CUSTOM_LLM_URL=http://localhost:11434/v1, no key needed

# === Vishap analyzer (optional) ===
# Command that starts the analyzer; default: vishap
# VISHAP_ANALYZER_CMD=python -m src.cli

# === Web form and API ===
# Required to bind to anything but 127.0.0.1:
# GENERATOR_API_TOKEN=
# Let the browser send its own model settings to a non-loopback server (default: no):
# GENERATOR_ALLOW_CLIENT_LLM=1

# === Logging, limits, cost ===
# LOG_LEVEL=INFO              # default WARNING
# LOG_FORMAT=json             # default pretty
# GENERATOR_RATE_LIMIT=30     # requests per minute per client address; 0 = off
# Prices in USD per 1M tokens; without them the cost is shown as 0.0
# GENERATOR_PRICE_IN=
# GENERATOR_PRICE_OUT=
