# Vishap — production env template (Render)

# === Backend (Render) ===
VISHAP_DEV=true
VISHAP_LLM_PROVIDER=custom
CUSTOM_LLM_URL=https://api.deepseek.com/v1
CUSTOM_LLM_MODEL=deepseek-chat
CUSTOM_LLM_KEY=sk-REPLACE_ME
VISHAP_DATA_DIR=/data
OTEL_SDK_DISABLED=true
PYTHONUNBUFFERED=1

# Optional auth (recommended for public deploy):
# VISHAP_API_KEY=generate-with-openssl-rand-hex-32

# === Frontend (any static/Node host; build-time vars) ===
NEXT_PUBLIC_API_URL=https://vishap-xxx.onrender.com
# Backend must allow the UI origin: VISHAP_CORS_ORIGINS=https://your-ui.example.com
# NEXT_PUBLIC_API_KEY=same-as-VISHAP_API_KEY
