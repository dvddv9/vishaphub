# Vishap — production env template (Render)

# === Backend (Render) ===
VISHAP_DEV=true
VISHAP_LLM_PROVIDER=custom
CUSTOM_LLM_URL=https://api.anthropic.com/v1
CUSTOM_LLM_MODEL=claude-haiku-5-5
CUSTOM_LLM_SEND_TEMPERATURE=false
CUSTOM_LLM_KEY=sk-ant-REPLACE_ME
VISHAP_DATA_DIR=/data
OTEL_SDK_DISABLED=true
PYTHONUNBUFFERED=1

# Public/demo deploy: never spend the operator's LLM key. A caller who brings a
# key (X-LLM-Api-Key; the UI has a field for it) gets the full LLM analysis with
# the provider they picked; a caller without a key gets the built-in rule engine
# (no LLM, free) instead of an error. Batch needs a key.
# VISHAP_REQUIRE_USER_LLM_KEY=1
# Opposite mode: ONLY the server's built-in key (CUSTOM_LLM_*, Claude) is used; the UI
# hides provider/model/key and X-LLM-* headers are ignored. Overrides the line above.
# VISHAP_SERVER_KEY_ONLY=1
# Providers a user may pick in the UI (default: anthropic,deepseek,openai,groq,openrouter):
# VISHAP_ALLOWED_PROVIDERS=anthropic,deepseek
# Also freeze POST /llm/config without requiring user keys:
# VISHAP_LLM_CONFIG_LOCKED=1
# Behind Render's proxy (1 hop) so the rate limiter sees real client IPs:
# VISHAP_TRUSTED_PROXY_HOPS=1

# Optional auth (recommended for public deploy):
# VISHAP_API_KEY=generate-with-openssl-rand-hex-32

# === Frontend (any static/Node host; build-time vars) ===
NEXT_PUBLIC_API_URL=https://vishap-xxx.onrender.com
# Backend must allow the UI origin: VISHAP_CORS_ORIGINS=https://your-ui.example.com
# NEXT_PUBLIC_API_KEY=same-as-VISHAP_API_KEY
