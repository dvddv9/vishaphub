# Copy to .env (the installer does this and fills in the secrets).

# --- the model --------------------------------------------------------------------------------------
# anthropic | openai | none
#   anthropic  Claude through api.anthropic.com
#   openai     anything that speaks the OpenAI chat API: OpenAI, OpenRouter, Ollama, LM Studio, vLLM, llama.cpp
#   none       no model: the rules and the validator still run, the model-written parts are off
VISHAP_HUB_LLM_PROVIDER=anthropic
# Needed for openai. Ollama on this machine, from inside the container:  http://host.docker.internal:11434/v1
VISHAP_HUB_LLM_URL=
VISHAP_HUB_LLM_MODEL=
# Empty for a local server; a hosted one needs it.
VISHAP_HUB_LLM_KEY=

# --- where nothing may leave ----------------------------------------------------------------------------
# 1 = the process refuses connections outside this machine and the private network (plus ALLOWED_HOSTS).
# It also turns the voice off, which is a Microsoft online service.
VISHAP_HUB_OFFLINE=
VISHAP_HUB_ALLOWED_HOSTS=
VISHAP_HUB_VOICE=1

# --- running submitted code -----------------------------------------------------------------------------
# host    inside this container, no sandbox beyond the container itself: for code you wrote or trust.
#         The hub's environment (including the model key) is readable by that code.
# auto    a worker container or network namespace if there is one, else nothing is run
# docker  only in a worker container (needs VISHAP_HUB_WORKER_IMAGE and the Docker CLI; not in this bundle)
VISHAP_HUB_ISOLATION=host

# --- who may come in ------------------------------------------------------------------------------------
VISHAP_HUB_BIND=127.0.0.1
VISHAP_HUB_PORT=8080
VISHAP_HUB_REQUIRE_KEY=

# --- team mode (docker compose --profile team up -d) ---------------------------------------------------------
POSTGRES_PASSWORD=
VISHAP_HUB_APP_PASSWORD=
# Set by the installer in team mode: postgresql://vishap_hub_app:<app password>@db:5432/vishap
VISHAP_HUB_DATABASE_URL=
