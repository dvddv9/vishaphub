# Vishap - environment variables
# Docs: https://github.com/dvddv9/vishap
#
# REQUIRED at startup (checked by config.validate_config): DATABASE_URL,
# CLERK_SECRET_KEY. The API refuses to start when one is
# missing. For local work without those keys, set VISHAP_DEV=true and the check
# downgrades to a warning.
#
# VISHAP_DEV=false

# For local DSH: run `dsh-model-endpoint` plugin, then set:
#   VISHAP_LLM_PROVIDER=custom
#   CUSTOM_LLM_URL=http://127.0.0.1:8787/v1
#   CUSTOM_LLM_KEY=<dsh-key>
#   CUSTOM_LLM_MODEL=auto
#

# === Server ===
PORT=8080
API_URL=http://localhost:5001
CONVEYOR_API_KEY=

# === Web Search (optional, for fresh CVEs and patches) ===
# Provider 1: Tavily (if TAVILY_API_KEY set)
TAVILY_API_KEY=tvly-your-tavily-key-here
ENABLE_WEB_SEARCH=false
DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/tools
SEARCH_MAX_RESULTS=5
SEARCH_DEPTH=basic

# === PostgreSQL (required at startup; also used by JOB_STORE=postgres) ===
DATABASE_URL=postgresql+asyncpg://vishap:vishap_dev@localhost:5432/vishap
POSTGRES_PASSWORD=vishap_dev

# === Logging (structlog, v6.1) ===
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# === Security (Fernet, v6.1) ===
FERNET_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# === Celery + Redis (v6.1 queue) ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === GitHub App (v6.1) ===
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# === Clerk auth (v6.1) вЂ” CLERK_SECRET_KEY is required at startup ===
# Get keys: https://dashboard.clerk.com -> API keys
# The value below is a placeholder: validate_config only checks that it is set,
# not that it is valid вЂ” a wrong key fails on the first authenticated request.
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=

# === Tenant API keys (v6.5) ===
# When true, X-API-Key also accepts keys issued by scripts/generate_key.py,
# looked up in the tenants table (status + expiry enforced). The static
# CONVEYOR_API_KEY keeps working either way. Requires alembic revision 004.
# Each rejected request costs one database lookup while this is on.
VISHAP_TENANT_KEYS=false

# Pepper for tenant API key hashes (HMAC-SHA256, v6.5-P0).
# MUST be set when VISHAP_TENANT_KEYS=true: hash_api_key() refuses to compute a
# digest without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never rotate casually вЂ” changing it invalidates every issued key.
API_KEY_PEPPER=change-me-in-production

# === Outbound email (v6.5) ===
# Leave SMTP_HOST empty to keep send_email() a no-op (it logs and returns False).
# Port 587 assumes STARTTLS; use 465 with an implicit-TLS provider only if you
# also switch the transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM defaults to SMTP_USER when empty.
SMTP_FROM=support@vishap.dev

# === OpenTelemetry (v6.1 tracing) ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vishap
OTEL_SDK_DISABLED=false
LLM_MODE=custom
# === LLM Provider ===
LLM_PROVIDER=custom

# === LLM: provider selection ===
# Options: custom (Claude/DeepSeek/OpenAI/Groq/Ollama) | dsh (DSH endpoint) | auto
# Default: custom (Claude via the Anthropic API)
VISHAP_LLM_PROVIDER=custom

# Claude (default; Anthropic OpenAI-compatible endpoint)
CUSTOM_LLM_URL=https://api.anthropic.com/v1
CUSTOM_LLM_KEY=sk-ant-...
CUSTOM_LLM_MODEL=claude-sonnet-5-5
# Claude 5.x: do not send temperature.
CUSTOM_LLM_SEND_TEMPERATURE=false

# DeepSeek (alternative)
# CUSTOM_LLM_URL=https://api.deepseek.com/v1
# CUSTOM_LLM_KEY=sk-...
# CUSTOM_LLM_MODEL=deepseek-chat
# CUSTOM_LLM_SEND_TEMPERATURE=true

# OpenAI (alternative)
# CUSTOM_LLM_URL=https://api.openai.com/v1
# CUSTOM_LLM_KEY=sk-...
# CUSTOM_LLM_MODEL=gpt-4o-mini

# Groq (alternative)
# CUSTOM_LLM_URL=https://api.groq.com/openai/v1
# CUSTOM_LLM_KEY=gsk_...
# CUSTOM_LLM_MODEL=llama3-70b-8192

# Ollama (local, no key)
# CUSTOM_LLM_URL=http://127.0.0.1:11434/v1
# CUSTOM_LLM_KEY=ollama
# CUSTOM_LLM_MODEL=llama3

# DSH endpoint (optional, via dsh-model-endpoint)
# VISHAP_LLM_PROVIDER=dsh
# CUSTOM_LLM_URL=http://127.0.0.1:8787/v1
# CUSTOM_LLM_KEY=<dsh-key>
# CUSTOM_LLM_MODEL=auto
