{
  "name": "vishap-security-bundle",
  "displayName": "Vishap Security Analysis",
  "version": "7.4.9",
  "description": "Security analysis for code, specs, logs and configs: CWE-tagged findings, STRIDE threat model and fixes, via your own Anthropic API key.",
  "author": {
    "name": "dvddv9",
    "email": "hndav9@yahoo.com"
  },
  "homepage": "https://github.com/dvddv9/vishap",
  "repository": "https://github.com/dvddv9/vishap",
  "license": "AGPL-3.0-or-later",
  "privacyPolicyUrl": "https://github.com/dvddv9/vishap/blob/main/claude-plugin-bundle-anthropic/README.md#privacy",
  "icon": "./assets/icon.png",
  "keywords": [
    "security",
    "sast",
    "stride",
    "cwe",
    "owasp",
    "claude",
    "anthropic",
    "audit"
  ],
  "mcpServers": {
    "vishap-analyze": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/scripts/analyze.py"
      ],
      "env": {
        "VISHAP_API_KEY": "${user_config.API_KEY}",
        "VISHAP_MODEL": "${user_config.ANTHROPIC_MODEL}"
      }
    }
  },
  "userConfig": {
    "API_KEY": {
      "type": "string",
      "title": "Anthropic API Key",
      "description": "sk-ant-... from console.anthropic.com/settings/keys",
      "sensitive": true,
      "required": true
    },
    "ANTHROPIC_MODEL": {
      "type": "string",
      "title": "Anthropic Model",
      "description": "Model name (e.g. claude-sonnet-5-5)",
      "required": true,
      "default": "claude-sonnet-5-5"
    }
  }
}
